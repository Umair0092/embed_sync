class Add<%= column.camelize %>To<%= table_name.camelize %> < ActiveRecord::Migration<%= migration_version %>
  def change
    # Guarded so rolling back this migration doesn't try to drop the extension other vector columns use.
    enable_extension "vector" unless extension_enabled?("vector")

    add_column :<%= table_name %>, :<%= column %>, :vector, limit: <%= options[:dimensions] %>
    add_column :<%= table_name %>, :<%= column %>_digest, :string
<% if index? -%>
    add_index :<%= table_name %>, :<%= column %>, using: :<%= options[:index] %>, opclass: :<%= opclass %>
<% end -%>
  end
end
